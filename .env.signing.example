# Apple notarization credentials — copy to .env.signing and fill in.
# .env.signing is gitignored: these are account credentials, never commit them.

# Your Apple ID email (the Developer Program account)
APPLE_ID="you@example.com"

# App-specific password from appleid.apple.com → Sign-In and Security →
# App-Specific Passwords. NOT your Apple ID password.
APPLE_APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# 10-character Team ID from developer.apple.com → Membership
APPLE_TEAM_ID="XXXXXXXXXX"
