{
  "appId": "com.coprep.desktop",
  "productName": "PathMaker4u-AI",
  "artifactName": "PathMaker4u-Setup-${arch}.${ext}",
  "copyright": "Copyright \u00a9 2026 PathMaker4u",
  "directories": {
    "output": "release",
    "buildResources": "assets"
  },
  "files": [
    "dist/**/*",
    "renderer/dist/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "dist/electron/main.js"
  },
  "protocols": [
    {
      "name": "PathMaker4u Protocol",
      "schemes": [
        "pathmaker4u",
        "coprep"
      ]
    }
  ],
  "mac": {
    "category": "public.app-category.productivity",
    "icon": "assets/logo.icns",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "entitlements.plist",
    "entitlementsInherit": "entitlements.plist",
    "extendInfo": {
      "LSUIElement": true,
      "LSBackgroundOnly": false,
      "NSSupportsAutomaticTermination": false,
      "NSMicrophoneUsageDescription": "PathMaker4u uses your microphone to transcribe your interview answers when you unmute the mic.",
      "NSAudioCaptureUsageDescription": "PathMaker4u captures system audio so interviewer questions can be transcribed during an interview session.",
      "NSCameraUsageDescription": "PathMaker4u uses screen capture only when you ask it to analyze your screen."
    },
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "notarize": true
  },
  "dmg": {
    "icon": "assets/logo.icns",
    "background": "assets/dmg-background.png",
    "title": "PathMaker4u-Installer-${arch}",
    "window": {
      "width": 540,
      "height": 380
    },
    "contents": [
      {
        "x": 144,
        "y": 150,
        "type": "file"
      },
      {
        "x": 396,
        "y": 150,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "win": {
    "icon": "assets/logo.ico",
    "legalTrademarks": "PathMaker4u",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64",
          "ia32"
        ]
      }
    ],
    "verifyUpdateCodeSignature": false,
    "signAndEditExecutable": true
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "installerIcon": "assets/logo.ico",
    "uninstallerIcon": "assets/logo.ico",
    "installerHeader": "assets/logo.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "PathMaker4u"
  },
  "linux": {
    "icon": "assets/logo.png",
    "category": "Office",
    "target": [
      {
        "target": "deb",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "maintainer": "CoPrep AI <support@coprep.ai>",
    "vendor": "PathMaker4u",
    "synopsis": "AI-powered interview preparation",
    "description": "AI-powered interview preparation desktop application"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "pathmaker4u-ai",
      "repo": "pathmaker4u-desktop-releases",
      "releaseType": "draft"
    }
  ]
}
